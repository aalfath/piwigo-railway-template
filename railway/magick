#!/bin/sh
# Piwigo calls `magick` once per thumbnail or resized copy. Run one at a time,
# so a page full of new photos can't start a dozen ImageMagick processes and
# exhaust a small (0.5 GB) Railway service. Waits at most 10 minutes for its turn.
exec /usr/bin/flock -w 600 /tmp/piwigo-magick.lock /usr/bin/magick "$@"
